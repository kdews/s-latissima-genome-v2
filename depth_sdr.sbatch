#!/bin/bash
#SBATCH -J depth_sdr
#SBATCH -o %x_logs/%x_%a_%j.log
#SBATCH -p gpu
#SBATCH --time=1-0
#SBATCH --mem=65g
#SBATCH --cpus-per-task=8
#SBATCH -a 1

# Script variables
# Extract job name from script
if [[ -n ${SLURM_JOB_NAME:-} ]]; then
  job_name="$SLURM_JOB_NAME"
elif [[ -n ${BASH_SOURCE[0]:-} && ${BASH_SOURCE[0]} != "bash" ]]; then
  job_name="$(basename "${BASH_SOURCE[0]}")"
  job_name="${job_name%%.*}"
else
  job_name="depth_sdr"
fi
scripts_dir="s-latissima-genome-v2" # scripts directory
main_outdir="sdr_id_results" # main output directory
depth_outdir="$main_outdir/${job_name}_results" # job type output directory

# Function to check output file exists before next step
check_output () {
  outfile="$1"
  if [[ -f "$outfile" ]]; then
    echo "Output file: $outfile"
    return 0
  else
    echo "Error: Output file ($outfile) not found."
    exit 1
  fi
}

# Help message
show_help () {
  echo "\
Identifies SDR with sex-biased depth analysis from Barrera-Redondo et al. (2025).
Reads must be include a roughly equal number of reads from opposite sex (os)
and same sex (ss) with respect to the assembly.

Usage: sbatch $job_name.sbatch <genome>.fa [scripts_dir] [--prepare-only]

Input:
  genome.fa       # genome assembly FASTA (.fa suffix REQUIRED)
  scripts_dir     # optional scripts directory (default: s-latissima-genome-v2)
  --prepare-only  # trim reads for this array sample, then exit (after scripts_dir)

Trimmed pairs and fastp reports are shared in $main_outdir/prepared/trimmed/.
Missing preparation is generated at runtime; local fastp reports are symlinks.

  Existing directory structure (generated by sdr_id.sbatch) is required:
  $depth_outdir/
  └── <genome>/
      ├── samples.tsv                            # 'Sample Sex'
      ├── read_pairs.tsv                         # 'Sample  Sex  Library  Pair_ID  R1  R2'
      ├── assembly_metadata.tsv                  # 'Label	Pretty_Label	Genome_Source	Genome_Method	Genome_Locator	Genome_Selector	Assembly_Reads_Source	Assembly_Reads_Method	Assembly_Reads_Platform	Assembly_Reads_Locator	Analysis_Reads_Platform	Analysis_Reads_Method	Analysis_Reads_Locator	Analysis_Reads_Female_Locator	Analysis_Reads_Male_Locator	Annotation_GFF	Sample_ID	Region	Sex	Ploidy'
      ├── <genome>.0123                          # bwa-mem2 index files
      ├── <genome>.amb                           # bwa-mem2 index files
      ├── <genome>.ann                           # bwa-mem2 index files
      └── <genome>.bwt.2bit.64                   # bwa-mem2 index files

Output:
  $main_outdir/
  ├── prepared/trimmed/<trim_id>/                    # trimmed reads for read set
  └── $(basename "$depth_outdir")/
      └── <genome>/
          ├── bams/                                  # individual-level BAMs
          │   ├── <indiv_n>.sorted.bam
          │   ├── <indiv_n>.sorted.bam.bai
          │   └── ...
          ├── mosdepth/                              # mosdepth result files
          │   ├── <indiv_n>.mosdepth.global.dist.txt  
          │   ├── <indiv_n>.mosdepth.region.dist.txt
          │   ├── <indiv_n>.mosdepth.summary.txt
          │   ├── <indiv_n>.regions.bed.gz
          │   ├── <indiv_n>.regions.bed.gz.csi
          │   └── ...
          └── depth_filt.png                         # plots of sample read depths

Requires:
 - Python 3 and sdr_prepare.py in scripts_dir
 - fastp and flock
 - bwa-mem2 v2.3 (https://github.com/bwa-mem2/bwa-mem2)
 - samtools v1.24 (https://www.htslib.org/)
 - mosdepth v0.3.14 (https://github.com/brentp/mosdepth)
 - R v6+ (https://www.r-project.org)"
}
if [[ $1 == "-h" ]] || [[ $1 == "--help" ]]; then
  show_help
  exit 0
elif [[ "$#" -lt 1 ]]; then
  echo "Error: at least 1 positional argument is required."
  echo
  show_help
  exit 1
fi

# Catch status codes in pipes
set -o pipefail

# Print Slurm job information
[[ -n "$SLURM_JOB_ID" ]] && echo "\
==========================================
SLURM_JOB_ID = $SLURM_JOB_ID
SLURM_JOB_NODELIST = $SLURM_JOB_NODELIST
TMPDIR = $TMPDIR
=========================================="
if [[ -n "$SLURM_ARRAY_TASK_ID" ]]; then
  echo "Slurm array job ID: ${SLURM_ARRAY_JOB_ID}_$SLURM_ARRAY_TASK_ID"
fi

# Load conda
module purge
cond="$HOME/.conda_for_sbatch.sh"
if [[ -f "$cond" ]]; then
  source "$cond"
else
  echo "Error sourcing $cond"
  exit 1
fi

# Print date and time
date_fmt="%-I:%M:%S %p (%a %d %b %Y)" # date format
date +"$date_fmt"
echo

# Multithread support
nthrd="${SLURM_CPUS_PER_TASK:-1}"

# Input
genome="${1:-"assemblies/corteva_v2_ha.fa"}" # genome FASTA of one sex (e.g., female, U)
prepare_only=false # set up optional prepare only run
scripts_var=""
for arg in "${@:2}"; do
  if [[ "$arg" == --prepare-only ]]; then
    prepare_only=true
  elif [[ -z "$scripts_var" ]]; then
    scripts_var="$arg" # optional user-set scripts directory name
  else
    echo "Error: unexpected argument: $arg" >&2
    exit 1
  fi
done
[[ -z "$scripts_var" ]] || scripts_dir="$scripts_var"
shared_out="$(realpath -m "$main_outdir/prepared/trimmed")" || exit 1

# Output
genome_base="$(basename "${genome%.fa}")" # genome filename base
depth_out="$depth_outdir/$genome_base" # job output subdirectory
[[ -d "$depth_out" ]] || { echo "Error: no output directory ($depth_out)"; exit 1; }
mkdir -p "$depth_out/bams" "$depth_out/mosdepth" "$depth_out/fastp"

# Index input tables with array ID
task="${SLURM_ARRAY_TASK_ID:-1}"
record="$(sed -n "$((task + 1))"p "$depth_out/samples.tsv")"
[[ -n "$record" ]] || { echo "No sample for task #$task" >&2; exit 1; }
IFS=$'\t' read -r indiv_id sex <<< "$record"
echo "Assembly=$genome_base; sample=$indiv_id; sex=$sex; task=$task"
echo

# Skip completed analysis except prep jobs
mosdepth_prefix="$depth_out/mosdepth/$indiv_id"
if [[ "$prepare_only" != true ]]; then
  depth_complete=true
  for suffix in mosdepth.global.dist.txt mosdepth.region.dist.txt \
    mosdepth.summary.txt regions.bed.gz regions.bed.gz.csi; do
    [[ -s "$mosdepth_prefix.$suffix" ]] || depth_complete=false
  done
  if [[ "$depth_complete" == true ]]; then
    echo "Mosdepth outputs already exist for $indiv_id; skipping analysis."
    exit 0
  fi
fi

# Reserve most memory for mapping
mem_mb="${SLURM_MEM_PER_NODE:-65000}" # default: 65,000 Mb
sort_threads="$((nthrd > 1 ? nthrd / 2 : 1))" # threads for samtools sort
mem_per_thread="$((mem_mb / 5 / (sort_threads + 1)))" # Mb of memory per thread
(( mem_per_thread > 0 )) || { echo 'Insufficient sort memory' >&2; exit 1; }

# Check conda envs
if [[ "$prepare_only" != true ]]; then
  conda activate bwa-mem2
  echo -n "bwa-mem2 version: "
  bwa-mem2 version 2>&1 | tail -n +3 || exit 1
  samtools --version | head -n2 || exit 1
  conda deactivate
fi
conda activate fastp
fastp --version || exit 1
conda deactivate
echo

# Parse read_pairs.tsv to align samples to genome assembly
work_dir="$(mktemp -d)"
bam_args=()
while IFS=$'\t' read -r sample read_sex library pair_id R1 R2 model; do
  [[ "$sample" == "$indiv_id" ]] || continue # select line(s) by ID match
  if ! [[ "$read_sex" == "$sex" && -r "$R1" && -r "$R2" ]]; then
    echo 'Error: Invalid read manifest row.' >&2
    exit 1
  fi
  # Use sequencing model when available; otherwise retain fastp auto-detection
  case "${model,,}" in
    *nextseq*|*novaseq*) poly_g_args=(--trim_poly_g --poly_g_min_len 8) ;;
    *hiseq*|*miseq*) poly_g_args=(--disable_trim_poly_g) ;;
    *) poly_g_args=() ;;
  esac
  echo "Pair=$pair_id; Model=${model:-Unknown}; poly-G=${poly_g_args[*]:-auto}"
  # Share trimming across assemblies; standalone jobs use the same preparation.
  trim_policy="fastp:detect_adapter_for_pe:poly_g=${poly_g_args[*]:-auto}"
  trim_id="$(python3 "$scripts_dir/sdr_prepare.py" --read-key \
    "$trim_policy" "$R1" "$R2")" || exit 1
  trim_dir="$shared_out/$trim_id"
  mkdir -p "$trim_dir" || exit 1
  trim_R1="$trim_dir/R1.fastq.gz"
  trim_R2="$trim_dir/R2.fastq.gz"
  (
    flock -x 9 || exit 1
    if [[ ! -f "$trim_dir/complete" || ! -s "$trim_R1" || ! -s "$trim_R2" ]]; then
      trim_work="$(mktemp -d "$trim_dir/.tmp.XXXXXX")" || exit 1
      trap 'rm -rf -- "$trim_work"' EXIT
      conda activate fastp || exit 1
      set -x
      fastp --in1 "$R1" --in2 "$R2" \
        --out1 "$trim_work/R1.fastq.gz" --out2 "$trim_work/R2.fastq.gz" \
        --detect_adapter_for_pe \
        "${poly_g_args[@]}" \
        --thread "$nthrd" \
        --html "$trim_work/fastp.html" \
        --json "$trim_work/fastp.json" \
        || exit 1
      { set +x; } 2>/dev/null
      [[ -s "$trim_work/R1.fastq.gz" && -s "$trim_work/R2.fastq.gz" ]] || exit 1
      rm -f "$trim_dir/complete" || exit 1
      mv "$trim_work/"* "$trim_dir/" || exit 1
      touch "$trim_dir/complete" || exit 1
    else
      echo "Using prepared trimmed reads."
      echo "R1: $trim_R1"
      echo "R2: $trim_R2"
    fi
  ) 9>"$trim_dir/.lock" || exit 1
  for report in html json; do
    ln -sfn "$trim_dir/fastp.$report" \
      "$depth_out/fastp/${indiv_id}.${pair_id}.$report" || exit 1
  done
  echo
  [[ "$prepare_only" != true ]] || continue
  
  # Align and sort reads
  conda activate bwa-mem2
  # Generic read groups support both SRA accessions and local Illumina filenames
  rg_lb="${indiv_id}_${library}" # same libraries retain common LB across lanes
  rg_id="${indiv_id}.${pair_id}" # each FASTQ pair has a unique read group ID
  sample_bam="$depth_out/bams/$pair_id.query.bam"
  set -x
  bwa-mem2 mem -t "$nthrd" \
    -R "@RG\tID:$rg_id\tSM:$indiv_id\tLB:$rg_lb\tPL:ILLUMINA\tPU:$rg_id" \
    "$depth_out/$genome_base" "$trim_R1" "$trim_R2" \
    | samtools sort -n -@ "$sort_threads" -m "${mem_per_thread}M"\
      -T "$work_dir/$pair_id.sort" -O bam -o "$sample_bam" || exit 1
  { set +x; } 2>/dev/null
  rm -rf -- "${work_dir:?}/"* # clean temp working directory
  bam_args+=(-I "$sample_bam")
  conda deactivate
done < <(tail -n +2 "$depth_out/read_pairs.tsv")
if [[ "$prepare_only" == true ]]; then
  rm -rf -- "$work_dir"
  exit 0
fi
(( ${#bam_args[@]} > 0 )) || { echo "No pairs for $indiv_id" >&2; exit 1; }
rm -rf -- "$work_dir"

# GATK4 Spark parameters
# Leave half the allocation for /tmp, overhead, and other processes
heap_mb="$(( mem_mb / 2 ))"
# Budget memory for large jobs
if [[ "$SLURM_JOB_PARTITION" == largemem ]]; then
  heap_cap_mb="$(( 350 * 1024 ))"
  (( heap_mb > heap_cap_mb )) && heap_mb="$heap_cap_mb"
fi

# Load GATK4
module purge
module load gcc/13.3.0 gatk/4.5.0.0 python/3.13.2 openjdk/21.0.0_35
gatk --version || exit 1

# Run GATK4's MarkDuplicates
work_dir="$(mktemp -d)"
indiv_bam="${indiv_id}.sorted.bam" # one BAM for biological individual
set -x
gatk --java-options "-Xmx${heap_mb}M" \
  MarkDuplicatesSpark -R "$genome" --tmp-dir "$work_dir" "${bam_args[@]}" \
  -O "$depth_out/bams/$indiv_bam" \
  -VS LENIENT \
  --spark-master "local[$nthrd]" \
  --conf spark.local.dir="$work_dir" \
  --conf spark.task.cpus=1 \
  || exit 1
{ set +x; } 2>/dev/null
module purge
check_output "$depth_out/bams/$indiv_bam"
check_output "$depth_out/bams/$indiv_bam.bai"
rm -rf -- "$work_dir"

# Calculate read depth across genome in 10-kb windows
conda activate mosdepth
mkdir -p "$depth_out/mosdepth"
set -x
mosdepth --threads "$nthrd" --by 10000 --fast-mode --mapq 30 --no-per-base \
  "$mosdepth_prefix" "$depth_out/bams/$indiv_bam" \
  || exit 1
{ set +x; } 2>/dev/null
conda deactivate

# Print date and time
echo
date_fmt="%-I:%M:%S %p (%a %d %b %Y)" # date format
date +"$date_fmt"
