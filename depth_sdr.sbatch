#!/bin/bash
#SBATCH -J depth_sdr
#SBATCH -o %x_logs/%x_%a_%j.log
#SBATCH -p gpu
#SBATCH --time=05:00:00
#SBATCH --mem=65g
#SBATCH --cpus-per-task=8
#SBATCH -a 1

# Script variables
# Extract job name from script
if [[ -n ${SLURM_JOB_NAME:-} ]]; then
  job_name="$SLURM_JOB_NAME"
elif [[ -n ${BASH_SOURCE[0]:-} && ${BASH_SOURCE[0]} != "bash" ]]; then
  job_name="$(basename "${BASH_SOURCE[0]}")"
  job_name="${job_name%%.*}"
else
  job_name="depth_sdr"
fi
main_outdir="sdr_id_results" # main output directory
depth_outdir="$main_outdir/${job_name}_results" # job type output directory

# Function to check output file exists before next step
check_output () {
  outfile="$1"
  if [[ -f "$outfile" ]]; then
    echo "Output file: $outfile"
    return 0
  else
    echo "Error: Output file ($outfile) not found."
    exit 1
  fi
}

# Help message
show_help () {
  echo "\
Identifies SDR with sex-biased depth analysis from Barrera-Redondo et al. (2025).
Reads must be include a roughly equal number of reads from opposite sex (os)
and same sex (ss) with respect to the assembly.

Usage: sbatch $job_name.sbatch <genome>.fa

Input:
  genome.fa     genome assembly FASTA (.fa suffix REQUIRED)

  Existing directory structure (generated by sdr_id.sbatch) is required:
  $depth_outdir/<genome>/
      └── <genome>/
          ├── samples.tsv                            # 'Sample Sex'
          ├── read_pairs.tsv                         # 'Sample  Sex  Library  Pair_ID  R1  R2'
          ├── assembly_metadata.tsv                  # 'Label	Pretty_Label	Genome_Source	Genome_Method	Genome_Locator	Genome_Selector	Assembly_Reads_Source	Assembly_Reads_Method	Assembly_Reads_Platform	Assembly_Reads_Locator	Analysis_Reads_Platform	Analysis_Reads_Method	Analysis_Reads_Locator	Analysis_Reads_Female_Locator	Analysis_Reads_Male_Locator	Annotation_GFF	Sample_ID	Region	Sex	Ploidy'
          ├── <genome>.0123                          # bwa-mem2 index files
          ├── <genome>.amb                           # bwa-mem2 index files
          ├── <genome>.ann                           # bwa-mem2 index files
          └── <genome>.bwt.2bit.64                   # bwa-mem2 index files

Output:
  $depth_outdir/<genome>/
      └── <genome>/
          ├── bams/                                  # individual-level BAMs
          │   ├── <indiv_n>.sorted.bam
          │   ├── <indiv_n>.sorted.bam.bai
          │   └── ...
          ├── mosdepth/                              # mosdepth result files
          │   ├── <indiv_n>.mosdepth.global.dist.txt  
          │   ├── <indiv_n>.mosdepth.region.dist.txt
          │   ├── <indiv_n>.mosdepth.summary.txt
          │   ├── <indiv_n>.regions.bed.gz
          │   ├── <indiv_n>.regions.bed.gz.csi
          │   └── ...
          └── depth_filt.png                         # plots of sample read depths

Requires:
 - bwa-mem2 v2.3 (https://github.com/bwa-mem2/bwa-mem2)
 - samtools v1.24 (https://www.htslib.org/)
 - mosdepth v0.3.14 (https://github.com/brentp/mosdepth)
 - R v6+ (https://www.r-project.org)"
}
if [[ $1 == "-h" ]] || [[ $1 == "--help" ]]; then
  show_help
  exit 0
elif [[ "$#" -lt 1 ]]; then
  echo "Error: at least 1 positional argument is required."
  echo
  show_help
  exit 1
fi

# Catch status codes in pipes
set -o pipefail

# Print Slurm job information
[[ -n "$SLURM_JOB_ID" ]] && echo "\
==========================================
SLURM_JOB_ID = $SLURM_JOB_ID
SLURM_JOB_NODELIST = $SLURM_JOB_NODELIST
TMPDIR = $TMPDIR
=========================================="
if [[ -n "$SLURM_ARRAY_TASK_ID" ]]; then
  echo "Slurm array job ID: ${SLURM_ARRAY_JOB_ID}_$SLURM_ARRAY_TASK_ID"
fi

# Load conda
module purge
cond="$HOME/.conda_for_sbatch.sh"
if [[ -f "$cond" ]]; then
  source "$cond"
else
  echo "Error sourcing $cond"
  exit 1
fi

# Print date and time
date_fmt="%-I:%M:%S %p (%a %d %b %Y)" # date format
date +"$date_fmt"
echo

# Multithread support
nthrd="${SLURM_CPUS_PER_TASK:-1}"

# Input
genome="${1:-"assemblies/corteva_v2_ha.fa"}" # genome FASTA of one sex (e.g., female, U)

# Output
genome_base="$(basename "${genome%.fa}")" # genome filename base
depth_out="$depth_outdir/$genome_base" # job output subdirectory
[[ -d "$depth_out" ]] || { echo "Error: no output directory ($depth_out)"; exit 1; }
mkdir -p "$depth_out/bams" "$depth_out/mosdepth"

# Index input tables with array ID
task="${SLURM_ARRAY_TASK_ID:-1}"
record="$(sed -n "$((task + 1))"p "$depth_out/samples.tsv")"
[[ -n "$record" ]] || { echo "No sample for task #$task" >&2; exit 1; }
IFS=$'\t' read -r indiv_id sex <<< "$record"
echo "Assembly=$genome_base; sample=$indiv_id; sex=$sex; task=$task"
echo

# Reserve most memory for mapping
mem_mb="${SLURM_MEM_PER_NODE:-65000}" # default: 65,000 Mb
sort_threads="$((nthrd > 1 ? nthrd / 2 : 1))" # threads for samtools sort
mem_per_thread="$((mem_mb / 5 / (sort_threads + 1)))" # Mb of memory per thread
(( mem_per_thread > 0 )) || { echo 'Insufficient sort memory' >&2; exit 1; }

# Parse read_pairs.tsv to align samples to genome assembly
conda activate bwa-mem2
echo -n "bwa-mem2 version: "
bwa-mem2 version 2>&1 | tail -n +3 || exit 1
samtools --version | head -n2 || exit 1
echo
work_dir="$(mktemp -d)"
bam_args=()
while IFS=$'\t' read -r sample read_sex library pair_id R1 R2; do
  [[ "$sample" == "$indiv_id" ]] || continue
  if ! [[ "$read_sex" == "$sex" && -r "$R1" && -r "$R2" ]]; then
    echo 'Invalid read manifest row' >&2
    exit 1
  fi
  # Generic read groups support both SRA accessions and local Illumina filenames
  rg_lb="${indiv_id}_${library}" # same libraries retain common LB across lanes
  rg_id="${indiv_id}.${pair_id}" # each FASTQ pair has a unique read group ID
  sample_bam="$depth_out/bams/$pair_id.query.bam"
  set -x
  bwa-mem2 mem -t "$nthrd" \
    -R "@RG\tID:$rg_id\tSM:$indiv_id\tLB:$rg_lb\tPL:ILLUMINA\tPU:$rg_id" \
    "$depth_out/$genome_base" "$R1" "$R2" \
    | samtools sort -n -@ "$sort_threads" -m "${mem_per_thread}M"\
      -T "$work_dir/$pair_id.sort" -O bam -o "$sample_bam" || exit 1
  { set +x; } 2>/dev/null
  bam_args+=(-I "$sample_bam")
done < <(tail -n +2 "$depth_out/read_pairs.tsv")
conda deactivate
(( ${#bam_args[@]} > 0 )) || { echo "No pairs for $indiv_id" >&2; exit 1; }
rm -rf -- "$work_dir"

# GATK4 Spark parameters
# Save 4gb for driver/off-heap and other threads
driver_mem=4000 # unit=M
exec_mem="$(( mem_mb * 9 / 10 - driver_mem ))" # unit=M
offheap_mem=2000 # off-heap shuffle buffer (unit=M)
# Partitons used for shuffling data during joins/aggregations
shuffle_parts="$(( nthrd * 3 ))" # avoid default 200

# Load GATK4
module purge
module load gcc/13.3.0 gatk/4.5.0.0 python/3.13.2 openjdk/21.0.0_35
gatk --version || exit 1

# Run GATK4's MarkDuplicates
work_dir="$(mktemp -d)"
indiv_bam="${indiv_id}.sorted.bam" # one BAM for biological individual
set -x
gatk MarkDuplicatesSpark -R "$genome" --tmp-dir "$work_dir" "${bam_args[@]}" \
  -O "$depth_out/bams/$indiv_bam" \
  -VS LENIENT \
  --spark-master "local[$nthrd]" \
  --conf spark.local.dir="$work_dir" \
  --conf spark.task.cpus=1 \
  --conf spark.executor.cores="$nthrd" \
  --conf spark.driver.cores=1 \
  --conf spark.executor.memory="${exec_mem}M" \
  --conf spark.driver.memory="${driver_mem}M" \
  --conf spark.memory.offHeap.enabled=true \
  --conf spark.memory.offHeap.size="${offheap_mem}M" \
  --conf spark.sql.shuffle.partitions="$shuffle_parts" \
  --conf spark.shuffle.file.buffer=32k \
  --conf spark.executor.heartbeatInterval="60s" \
  --conf spark.network.timeout="300s" \
  || exit 1
{ set +x; } 2>/dev/null
module purge
check_output "$depth_out/bams/$indiv_bam"
check_output "$depth_out/bams/$indiv_bam.bai"
rm -rf -- "$work_dir"

# Calculate read depth across genome in 10-kb windows
conda activate mosdepth
mkdir -p "$depth_out/mosdepth"
set -x
mosdepth --threads "$nthrd" --by 10000 --fast-mode --mapq 30 --no-per-base \
  "$depth_out/mosdepth/$indiv_id" "$depth_out/bams/$indiv_bam" \
  || exit 1
{ set +x; } 2>/dev/null
conda deactivate

# Print date and time
echo
date_fmt="%-I:%M:%S %p (%a %d %b %Y)" # date format
date +"$date_fmt"
